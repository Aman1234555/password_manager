# Email OTP settings for SMTP transport
# ======================================
# Option 1: Gmail (FREE - Recommended)
# 1. Enable 2FA on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-char password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Secure Password Manager <your-gmail@gmail.com>"

# Optional: Email API keys for alternative providers (leave empty if using SMTP)
# ============================================================================
# Option 2: Brevo API
BREVO_API_KEY=

# Option 3: SendGrid API
SENDGRID_API_KEY=

# Option 4: Mailgun API
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net/v3

# OTP expiration in minutes
OTP_EXPIRE_MINUTES=15

